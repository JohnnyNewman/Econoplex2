// What buildings are made of, with the building materials of
// 16_building_materials.ron. This file loads last and overrides each build
// recipe by id: timber buildings take beams, planks and thatch, all made from
// wood and grain, so any new town can put them up; stone and brick buildings take mortar, beams,
// roof tiles and, from the iron age, nails. Delete this file to go back to the
// costs in each chain's own file.
(
    recipes: [
        // Timber.
        (id: "build_workshop", name: "Build workshop", skill: "construction", difficulty: 0.30,
            requires: ["saw_planks"],
            inputs: [("plank", 6), ("beam", 3), ("thatch", 4)], outputs: [("workshop", 1)],
            duration: 30.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_mill", name: "Build mill", skill: "construction", difficulty: 0.35,
            requires: ["build_workshop"],
            inputs: [("plank", 8), ("beam", 5), ("thatch", 4)], outputs: [("mill", 1)],
            duration: 40.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_bakery", name: "Build bakery", skill: "construction", difficulty: 0.35,
            requires: ["build_workshop"],
            inputs: [("plank", 8), ("beam", 3), ("thatch", 4)], outputs: [("bakery", 1)],
            duration: 35.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_furnace", name: "Build furnace", skill: "construction", difficulty: 0.45,
            requires: ["build_workshop"],
            inputs: [("plank", 4), ("beam", 2), ("wood", 14)], outputs: [("furnace", 1)],
            duration: 40.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_weaving_shed", name: "Build weaving shed", skill: "construction", difficulty: 0.30,
            requires: ["build_workshop", "weave_cloth"],
            inputs: [("plank", 6), ("beam", 3), ("thatch", 4)], outputs: [("weaving_shed", 1)],
            duration: 30.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_masons_yard", name: "Build mason's yard", skill: "construction", difficulty: 0.25,
            requires: ["build_workshop", "cut_stone"],
            inputs: [("plank", 4), ("beam", 2), ("thatch", 3)], outputs: [("masons_yard", 1)],
            duration: 25.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_kiln", name: "Build kiln", skill: "construction", difficulty: 0.35,
            requires: ["build_workshop", "throw_pots"],
            inputs: [("stone", 12), ("clay", 10), ("beam", 2)], outputs: [("kiln", 1)],
            duration: 30.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_stable", name: "Build stable", skill: "construction", difficulty: 0.35,
            requires: ["build_workshop"],
            inputs: [("plank", 8), ("beam", 3), ("thatch", 6)], outputs: [("stable", 1)],
            duration: 30.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_smithy", name: "Build smithy", skill: "construction", difficulty: 0.50,
            requires: ["build_workshop"],
            inputs: [("plank", 6), ("beam", 3), ("iron", 6)], outputs: [("smithy", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        // Stone and brick.
        (id: "build_brewery", name: "Build brewery", skill: "construction", difficulty: 0.40,
            requires: ["build_workshop", "fire_bricks"],
            inputs: [("brick", 16), ("beam", 2), ("mortar", 2), ("roof_tile", 4)], outputs: [("brewery", 1)],
            duration: 35.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_mint", name: "Build mint", skill: "construction", difficulty: 0.45,
            requires: ["build_furnace", "refine_silver"],
            inputs: [("cut_stone", 12), ("beam", 3), ("plank", 4)], outputs: [("mint", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_blast_furnace", name: "Build blast furnace", skill: "construction", difficulty: 0.55,
            requires: ["build_furnace", "fire_bricks", "cut_stone", "smelt_iron"],
            inputs: [("brick", 24), ("cut_stone", 12), ("mortar", 3), ("iron", 6)], outputs: [("blast_furnace", 1)],
            duration: 60.0, max_team: 8, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_machine_shop", name: "Build machine shop", skill: "construction", difficulty: 0.50,
            requires: ["build_smithy", "make_machine_parts"],
            inputs: [("brick", 16), ("beam", 3), ("mortar", 2), ("roof_tile", 4), ("nails", 24), ("iron", 6)],
            outputs: [("machine_shop", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_roller_mill", name: "Build roller mill", skill: "construction", difficulty: 0.55,
            requires: ["build_mill", "make_machine_parts"],
            inputs: [("brick", 16), ("cut_stone", 8), ("mortar", 2), ("roof_tile", 4), ("machine_parts", 3)],
            outputs: [("roller_mill", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_textile_mill", name: "Build textile mill", skill: "construction", difficulty: 0.55,
            requires: ["build_weaving_shed", "make_machine_parts"],
            inputs: [("brick", 20), ("cut_stone", 10), ("mortar", 2), ("roof_tile", 4), ("machine_parts", 4)],
            outputs: [("textile_mill", 1)],
            duration: 60.0, max_team: 8, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
