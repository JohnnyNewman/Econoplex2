// Houses (plan Phase 4): where people live, made of the building materials.
// A house holds `residents` people and shelters them by its `quality`; the
// town's shelter is what its best houses give its people, and whoever finds no
// room has none. Houses are counted per town, not placed one by one. A town
// builds them while its people lack room, and better ones while its shelter is
// poor. Towns start in cottages (`starter`). Its own file, so it can change or
// go on its own.
(
    products: [
        (id: "hut", name: "Hut", category: Building, base_price: 40.0,
            house: Some((residents: 5, quality: 0.5))),
        (id: "cottage", name: "Cottage", category: Building, base_price: 90.0, starter: true,
            house: Some((residents: 6, quality: 0.8))),
        (id: "stone_house", name: "Stone house", category: Building, era: 1, base_price: 220.0,
            house: Some((residents: 8, quality: 1.0))),
    ],
    recipes: [
        (id: "build_hut", name: "Build hut", skill: "construction", difficulty: 0.15,
            requires: ["chop_wood"],
            inputs: [("wood", 6), ("thatch", 2)], outputs: [("hut", 1)],
            duration: 8.0, max_team: 3, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_cottage", name: "Build cottage", skill: "construction", difficulty: 0.25,
            requires: ["saw_planks", "hew_beams", "bind_thatch"],
            inputs: [("plank", 6), ("beam", 3), ("thatch", 4)], outputs: [("cottage", 1)],
            duration: 15.0, max_team: 4, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_stone_house", name: "Build stone house", skill: "construction", difficulty: 0.35,
            requires: ["cut_stone", "mix_mortar", "fire_tiles"],
            inputs: [("cut_stone", 10), ("mortar", 3), ("beam", 3), ("roof_tile", 6)], outputs: [("stone_house", 1)],
            duration: 25.0, max_team: 4, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
