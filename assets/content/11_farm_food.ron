// Farm food (plan Phase 4, food batch): cattle, hens, gardens and orchards,
// with salt and a smokehouse to keep food. Beside the bread chain
// (10_agriculture.ron) and wild food (08_wild_food.ron), these give a town
// protein, fat and vitamins (see the nutrition design note). Gardens and
// orchards are crops (`farming.crops` in models.ron), so vegetables and fruit
// come in the growing season only; salted food keeps through winter. Hides
// wait for leather. Its own file, so it can change or go on its own.
(
    nature: [
        // Opened by planting a garden plot or an orchard (land, like a woodlot).
        (id: "garden",      name: "Garden",      regrowth: 20.0, capacity: 80.0),
        (id: "orchard",     name: "Orchard",     regrowth: 25.0, capacity: 120.0),
        (id: "salt_spring", name: "Salt spring", regrowth: 5.0,  capacity: 150.0),
    ],
    skills: [
        (id: "herding",      name: "Herding",      domain: "agriculture", prereqs: ["farming"]),
        (id: "gardening",    name: "Gardening",    domain: "agriculture", prereqs: ["farming"]),
        (id: "orcharding",   name: "Orcharding",   domain: "agriculture", prereqs: ["gardening"]),
        (id: "butchery",     name: "Butchery",     domain: "food",        prereqs: ["herding"]),
        (id: "dairying",     name: "Dairying",     domain: "food",        prereqs: ["herding"]),
        (id: "preserving",   name: "Preserving",   domain: "food",        prereqs: ["salt_boiling"]),
        (id: "salt_boiling", name: "Salt boiling", domain: "mining"),
        (id: "candle_making", name: "Candle making", domain: "food",      prereqs: ["butchery"]),
    ],
    products: [
        (id: "milk",        name: "Milk",        category: Food, base_price: 1.0, food: 0.4),
        (id: "cheese",      name: "Cheese",      category: Food, era: 1, base_price: 5.0, food: 1.5),
        (id: "eggs",        name: "Eggs",        category: Food, base_price: 0.8, food: 0.3),
        (id: "vegetables",  name: "Vegetables",  category: Food, base_price: 1.2, food: 0.5),
        (id: "fruit",       name: "Fruit",       category: Food, base_price: 1.2, food: 0.4),
        (id: "salted_fish", name: "Salted fish", category: Food, era: 1, base_price: 2.5, food: 0.5),
        (id: "salted_meat", name: "Salted meat", category: Food, era: 1, base_price: 3.5, food: 0.8),
        (id: "salt",        name: "Salt",        category: Material, era: 1, base_price: 3.0),
        (id: "tallow",      name: "Tallow",      category: Material, base_price: 2.0),
        // Light to read and work by on winter evenings.
        (id: "candles",     name: "Candles",     category: Material, era: 1, base_price: 2.0,
            household: Some((life_days: 15.0,
                serves: [(need: Growth, amount: 0.1, by: Consume)]))),
        (id: "garden_plot", name: "Garden plot", category: Building, base_price: 80.0, opens: Some("garden")),
        (id: "orchard_plot", name: "Orchard",    category: Building, base_price: 200.0, opens: Some("orchard")),
        (id: "dairy",       name: "Dairy",       category: Building, era: 1, base_price: 200.0, slots: 10),
        (id: "smokehouse",  name: "Smokehouse",  category: Building, era: 1, base_price: 180.0, slots: 10),
        (id: "saltern",     name: "Saltern",     category: Building, era: 1, base_price: 220.0, slots: 8),
    ],
    recipes: [
        (id: "milk_cows", name: "Milk cows", skill: "herding", difficulty: 0.15,
            requires: ["shear_sheep"],
            outputs: [("milk", 6)], nature: Some("pasture"), duration: 1.0, max_team: 3,
            physique: [("endurance", 0.2), ("dexterity", 0.1)]),
        // Draws the pasture down hard: a herd grows back slowly.
        (id: "slaughter_cattle", name: "Slaughter cattle", skill: "butchery", difficulty: 0.30,
            requires: ["milk_cows"],
            outputs: [("meat", 5), ("tallow", 2)], nature: Some("pasture"), duration: 3.0, max_team: 3,
            physique: [("strength", 0.3), ("endurance", 0.1)]),
        (id: "keep_hens", name: "Keep hens", skill: "herding", difficulty: 0.10,
            requires: ["farm_grain"],
            inputs: [("grain", 2)], outputs: [("eggs", 4)], duration: 1.0, max_team: 1,
            physique: [("dexterity", 0.1)]),
        (id: "make_cheese", name: "Make cheese", skill: "dairying", difficulty: 0.35,
            requires: ["milk_cows", "boil_salt", "build_dairy"],
            inputs: [("milk", 8), ("salt", 1)], outputs: [("cheese", 2)], building: Some("dairy"),
            duration: 1.0, physique: [("strength", 0.1), ("dexterity", 0.1)]),
        (id: "grow_vegetables", name: "Grow vegetables", skill: "gardening", difficulty: 0.10,
            requires: ["farm_grain"],
            outputs: [("vegetables", 5)], nature: Some("garden"), duration: 1.0, max_team: 2,
            physique: [("endurance", 0.2)]),
        (id: "pick_fruit", name: "Pick fruit", skill: "orcharding", difficulty: 0.10,
            requires: ["grow_vegetables"],
            outputs: [("fruit", 6)], nature: Some("orchard"), duration: 1.0, max_team: 4,
            physique: [("dexterity", 0.2)]),
        (id: "boil_salt", name: "Boil salt", skill: "salt_boiling", difficulty: 0.25,
            requires: ["chop_wood"],
            inputs: [("wood", 2)], outputs: [("salt", 2)], nature: Some("salt_spring"), building: Some("saltern"),
            duration: 1.0, max_team: 3, physique: [("endurance", 0.2)]),
        (id: "salt_fish", name: "Salt fish", skill: "preserving", difficulty: 0.25,
            requires: ["catch_fish", "boil_salt", "build_smokehouse"],
            inputs: [("fish", 4), ("salt", 1)], outputs: [("salted_fish", 4)], building: Some("smokehouse"),
            duration: 0.5, max_team: 3, physique: [("dexterity", 0.1)]),
        (id: "cure_meat", name: "Cure meat", skill: "preserving", difficulty: 0.30,
            requires: [["hunt_game", "slaughter_cattle"], "boil_salt", "build_smokehouse"],
            inputs: [("meat", 4), ("salt", 1)], outputs: [("salted_meat", 4)], building: Some("smokehouse"),
            duration: 0.5, max_team: 3, physique: [("dexterity", 0.1)]),
        (id: "dip_candles", name: "Dip candles", skill: "candle_making", difficulty: 0.20,
            requires: ["slaughter_cattle"],
            inputs: [("tallow", 2)], outputs: [("candles", 6)], building: Some("workshop"),
            duration: 0.5, max_team: 2, physique: [("dexterity", 0.2)]),
        (id: "plant_garden", name: "Plant garden", skill: "gardening", difficulty: 0.15,
            requires: ["farm_grain"],
            outputs: [("garden_plot", 1)], duration: 10.0, max_team: 3,
            physique: [("endurance", 0.3)]),
        (id: "plant_orchard", name: "Plant orchard", skill: "orcharding", difficulty: 0.20,
            requires: ["grow_vegetables"],
            inputs: [("wood", 10)], outputs: [("orchard_plot", 1)], duration: 20.0, max_team: 4,
            physique: [("endurance", 0.3)]),
        (id: "build_dairy", name: "Build dairy", skill: "construction", difficulty: 0.30,
            requires: ["build_workshop"],
            inputs: [("plank", 10), ("beam", 2), ("thatch", 4)], outputs: [("dairy", 1)],
            duration: 25.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_smokehouse", name: "Build smokehouse", skill: "construction", difficulty: 0.30,
            requires: ["build_workshop"],
            inputs: [("plank", 6), ("beam", 2), ("stone", 6)], outputs: [("smokehouse", 1)],
            duration: 25.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_saltern", name: "Build saltern", skill: "construction", difficulty: 0.30,
            requires: ["build_workshop", "fire_bricks"],
            inputs: [("plank", 6), ("brick", 10)], outputs: [("saltern", 1)],
            duration: 25.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
