// Leather (nutrition design note, step 5): a slaughtered beast or a hunt also
// gives a hide. A tannery turns hides (with bark, as wood) into leather; from
// leather come shoes, which keep feet warm and dry, and leather armour, a
// cheap armour between the padded coat and mail. A raw hide rots within a
// month (14_keeping.ron has the food; hides keep below), so hides are tanned
// where they are taken. This file overrides `hunt_game` and `slaughter_cattle`
// by id to add the hide: delete it, and those recipes are as in their own
// files again.
(
    skills: [
        (id: "tanning",        name: "Tanning",        domain: "textiles", prereqs: ["butchery"]),
        (id: "leatherworking", name: "Leatherworking", domain: "textiles", prereqs: ["tanning"]),
    ],
    products: [
        (id: "hide",    name: "Hide",    category: Material, base_price: 2.0),
        (id: "leather", name: "Leather", category: Material, era: 1, base_price: 6.0),
        (id: "shoes",   name: "Shoes",   category: Material, era: 1, base_price: 10.0,
            household: Some((life_days: 240.0,
                serves: [(need: Warmth, amount: 1.0, by: Wear), (need: Esteem, amount: 0.05, by: Own)]))),
        // Boiled leather: better than quilting against a blow, little use
        // against a point.
        (id: "leather_armour", name: "Leather armour", category: Weapon, era: 1, base_price: 40.0, kg: 6.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 80, slot: Some("armour"))),
            fight: Some((ac: 2, resist: [Blunt]))),
        (id: "tannery", name: "Tannery", category: Building, era: 1, base_price: 200.0, slots: 8),
    ],
    keeping: [
        (product: "hide", days: 30.0),
    ],
    recipes: [
        // As in 08_wild_food.ron, with the hide.
        (id: "hunt_game", name: "Hunt game", skill: "hunting", difficulty: 0.30,
            outputs: [("meat", 3), ("hide", 1)], nature: Some("hunting_ground"), duration: 1.5, max_team: 3,
            physique: [("endurance", 0.3), ("perception", 0.2)]),
        // As in 11_farm_food.ron, with the hide.
        (id: "slaughter_cattle", name: "Slaughter cattle", skill: "butchery", difficulty: 0.30,
            requires: ["milk_cows"],
            outputs: [("meat", 5), ("tallow", 2), ("hide", 1)], nature: Some("pasture"), duration: 3.0, max_team: 3,
            physique: [("strength", 0.3), ("endurance", 0.1)]),
        (id: "tan_hides", name: "Tan hides", skill: "tanning", difficulty: 0.35,
            requires: [["hunt_game", "slaughter_cattle"], "build_tannery"],
            inputs: [("hide", 2), ("wood", 1)], outputs: [("leather", 2)], building: Some("tannery"),
            duration: 2.0, max_team: 3, physique: [("strength", 0.2), ("endurance", 0.1)]),
        (id: "make_shoes", name: "Make shoes", skill: "leatherworking", difficulty: 0.40,
            requires: ["tan_hides", "build_workshop"],
            inputs: [("leather", 1)], outputs: [("shoes", 2)], building: Some("workshop"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.3)]),
        (id: "make_leather_armour", name: "Make leather armour", skill: "leatherworking", difficulty: 0.45,
            requires: ["tan_hides", "build_workshop"],
            inputs: [("leather", 4)], outputs: [("leather_armour", 1)], building: Some("workshop"),
            duration: 2.0, max_team: 2, physique: [("dexterity", 0.3), ("strength", 0.1)]),
        (id: "build_tannery", name: "Build tannery", skill: "construction", difficulty: 0.30,
            requires: ["build_workshop"],
            inputs: [("plank", 6), ("beam", 2), ("stone", 6)], outputs: [("tannery", 1)],
            duration: 25.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
