// Town walls (war idea 10): a timber palisade first, a stone wall later,
// each with its gates. A town that wants a wall lays out a ring round its
// houses, with a gate where each road comes in (`sim_core::walls`), and
// builds it a piece at a time from building materials and labour, like a
// house: each piece made goes up in the next gap. Pieces rot or crack a
// little every year (`decay`), and a battle batters them; the town mends
// them with new pieces. Once a town can cut stone it builds stone pieces
// and replaces its palisade with them (`rank`). In a battle each piece is
// an obstacle with its hit points (`hp`), and a gate lets only the
// defenders through.
(
    products: [
        (id: "palisade", name: "Palisade", category: Building, base_price: 60.0,
            wall: Some((hp: 400.0, thickness: 0.6, gate: false, decay: 0.06, rank: 0))),
        (id: "palisade_gate", name: "Palisade gate", category: Building, base_price: 80.0,
            wall: Some((hp: 300.0, thickness: 0.6, gate: true, decay: 0.06, rank: 0))),
        (id: "stone_wall", name: "Stone wall", category: Building, era: 1, base_price: 220.0,
            wall: Some((hp: 2000.0, thickness: 1.5, gate: false, decay: 0.01, rank: 1))),
        (id: "stone_gate", name: "Stone gatehouse", category: Building, era: 1, base_price: 260.0,
            wall: Some((hp: 900.0, thickness: 1.5, gate: true, decay: 0.01, rank: 1))),
    ],
    recipes: [
        (id: "build_palisade", name: "Build palisade", skill: "construction", difficulty: 0.15,
            requires: ["chop_wood", "hew_beams"],
            inputs: [("wood", 12), ("beam", 4)], outputs: [("palisade", 1)],
            duration: 8.0, max_team: 4, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_palisade_gate", name: "Build palisade gate", skill: "construction", difficulty: 0.25,
            requires: ["chop_wood", "hew_beams", "saw_planks"],
            inputs: [("wood", 6), ("beam", 6), ("plank", 6)], outputs: [("palisade_gate", 1)],
            duration: 10.0, max_team: 4, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_stone_wall", name: "Build stone wall", skill: "construction", difficulty: 0.35,
            requires: ["cut_stone", "mix_mortar"],
            inputs: [("cut_stone", 24), ("mortar", 6)], outputs: [("stone_wall", 1)],
            duration: 25.0, max_team: 4, physique: [("strength", 0.4), ("endurance", 0.2)]),
        (id: "build_stone_gate", name: "Build stone gatehouse", skill: "construction", difficulty: 0.40,
            requires: ["cut_stone", "mix_mortar", "saw_planks"],
            inputs: [("cut_stone", 16), ("mortar", 4), ("beam", 6), ("plank", 4)], outputs: [("stone_gate", 1)],
            duration: 25.0, max_team: 4, physique: [("strength", 0.4), ("endurance", 0.2)]),
    ],
)
