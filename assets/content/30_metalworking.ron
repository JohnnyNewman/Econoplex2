// Metalworking: ore to iron and steel, tools, and longswords at three levels.
//
//   Level 1: smelt iron -> forge iron blade -> assemble
//   Level 2: ... -> make steel -> forge steel blade -> assemble
//   Level 3: ... -> make steel -> forge steel blade -> temper -> grind -> assemble
(
    skills: [
        (id: "mining",        name: "Mining",        domain: "mining"),
        (id: "smelting",      name: "Smelting",      domain: "metallurgy", prereqs: ["mining", "charcoal_burning"]),
        (id: "steelmaking",   name: "Steelmaking",   domain: "metallurgy", prereqs: ["smelting"]),
        (id: "smithing",      name: "Smithing",      domain: "smithing",   prereqs: ["smelting"]),
        (id: "toolmaking",    name: "Toolmaking",    domain: "smithing",   prereqs: ["smithing", "carpentry"]),
        (id: "bladesmithing", name: "Bladesmithing", domain: "smithing",   prereqs: ["smithing"]),
        (id: "tempering",     name: "Tempering",     domain: "smithing",   prereqs: ["bladesmithing", "steelmaking"]),
        (id: "grinding",      name: "Grinding",      domain: "smithing",   prereqs: ["bladesmithing"]),
        (id: "sword_assembly", name: "Sword assembly", domain: "smithing", prereqs: ["bladesmithing", "hilt_making"]),
    ],
    products: [
        (id: "ore",   name: "Iron ore", category: Raw,      base_price: 1.5),
        (id: "iron",  name: "Iron",     category: Material, base_price: 15.0),
        (id: "steel", name: "Steel",    category: Material, base_price: 55.0),
        (id: "iron_blade",     name: "Iron blade",     category: Material, base_price: 45.0),
        (id: "steel_blade",    name: "Steel blade",    category: Material, base_price: 140.0),
        (id: "tempered_blade", name: "Tempered blade", category: Material, base_price: 175.0),
        (id: "sharp_blade",    name: "Sharp blade",    category: Material, base_price: 215.0),
        (id: "hammer", name: "Hammer", category: Tool, base_price: 30.0,
            equip: Some((domain: "smithing", bonus: 0.3))),
        (id: "pickaxe", name: "Pickaxe", category: Tool, base_price: 30.0,
            equip: Some((domain: "mining", bonus: 0.25))),
        (id: "longsword_1", name: "Iron longsword (lvl 1)",       category: Weapon, tier: 1, base_price: 70.0),
        (id: "longsword_2", name: "Steel longsword (lvl 2)",      category: Weapon, tier: 2, base_price: 190.0),
        (id: "longsword_3", name: "Fine steel longsword (lvl 3)", category: Weapon, tier: 3, base_price: 290.0),
    ],
    recipes: [
        (id: "mine_ore", name: "Mine ore", skill: "mining", difficulty: 0.15,
            outputs: [("ore", 3)], nature: Some("ore_vein"), duration: 1.0, max_team: 4,
            physique: [("strength", 0.4), ("endurance", 0.2)]),
        (id: "smelt_iron", name: "Smelt iron", skill: "smelting", difficulty: 0.45,
            inputs: [("ore", 3), ("charcoal", 1)], outputs: [("iron", 1)], building: Some("furnace"),
            duration: 1.5, physique: [("endurance", 0.2), ("strength", 0.1)]),
        (id: "make_steel", name: "Make steel", skill: "steelmaking", difficulty: 0.70,
            inputs: [("iron", 2), ("charcoal", 2)], outputs: [("steel", 1)], building: Some("furnace"),
            duration: 2.0, physique: [("endurance", 0.2)]),
        (id: "forge_hammer", name: "Forge hammer", skill: "toolmaking", difficulty: 0.50,
            inputs: [("iron", 1), ("plank", 1)], outputs: [("hammer", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("strength", 0.3)]),
        (id: "forge_pickaxe", name: "Forge pickaxe", skill: "toolmaking", difficulty: 0.50,
            inputs: [("iron", 1), ("plank", 1)], outputs: [("pickaxe", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("strength", 0.3)]),
        (id: "forge_axe", name: "Forge axe", skill: "toolmaking", difficulty: 0.45,
            inputs: [("iron", 1), ("plank", 1)], outputs: [("axe", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("strength", 0.3)]),
        (id: "forge_sickle", name: "Forge sickle", skill: "toolmaking", difficulty: 0.40,
            inputs: [("iron", 1)], outputs: [("sickle", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("strength", 0.2)]),
        (id: "forge_iron_blade", name: "Forge iron blade", skill: "bladesmithing", difficulty: 0.55,
            inputs: [("iron", 2)], outputs: [("iron_blade", 1)], building: Some("smithy"),
            duration: 1.5, physique: [("strength", 0.3), ("dexterity", 0.1)]),
        (id: "forge_steel_blade", name: "Forge steel blade", skill: "bladesmithing", difficulty: 0.80,
            inputs: [("steel", 2)], outputs: [("steel_blade", 1)], building: Some("smithy"),
            duration: 2.0, physique: [("strength", 0.3), ("dexterity", 0.1)]),
        (id: "temper_blade", name: "Temper blade", skill: "tempering", difficulty: 0.90,
            inputs: [("steel_blade", 1), ("charcoal", 1)], outputs: [("tempered_blade", 1)],
            building: Some("smithy"), duration: 1.5, max_team: 2, physique: [("perception", 0.3)]),
        (id: "grind_blade", name: "Grind blade", skill: "grinding", difficulty: 0.75,
            inputs: [("tempered_blade", 1)], outputs: [("sharp_blade", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 1, physique: [("dexterity", 0.4)]),
        (id: "assemble_longsword_1", name: "Assemble iron longsword", skill: "sword_assembly", difficulty: 0.50,
            inputs: [("iron_blade", 1), ("hilt", 1)], outputs: [("longsword_1", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.2)]),
        (id: "assemble_longsword_2", name: "Assemble steel longsword", skill: "sword_assembly", difficulty: 0.70,
            inputs: [("steel_blade", 1), ("hilt", 1)], outputs: [("longsword_2", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.2)]),
        (id: "assemble_longsword_3", name: "Assemble fine longsword", skill: "sword_assembly", difficulty: 0.95,
            inputs: [("sharp_blade", 1), ("hilt", 1)], outputs: [("longsword_3", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.3)]),
    ],
)
