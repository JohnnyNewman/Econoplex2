// Husbandry, textiles and brewing (era 1 to 2): wool and flax to yarn, cloth and
// clothes; grain and pots to ale, a second food.
(
    skills: [
        (id: "shepherding",  name: "Shepherding",  domain: "agriculture", prereqs: ["farming"]),
        (id: "spinning",     name: "Spinning",     domain: "textiles",    prereqs: ["shepherding"]),
        (id: "weaving",      name: "Weaving",      domain: "textiles",    prereqs: ["spinning"]),
        (id: "tailoring",    name: "Tailoring",    domain: "textiles",    prereqs: ["weaving"]),
        (id: "brewing",      name: "Brewing",      domain: "food",        prereqs: ["milling", "pottery"]),
    ],
    products: [
        (id: "wool",    name: "Wool",    category: Raw,      base_price: 1.5),
        (id: "flax",    name: "Flax",    category: Raw,      base_price: 1.0),
        (id: "yarn",    name: "Yarn",    category: Material, era: 1, base_price: 3.0),
        (id: "cloth",   name: "Cloth",   category: Material, era: 1, base_price: 10.0),
        (id: "clothes", name: "Clothes", category: Material, era: 1, base_price: 28.0),
        (id: "ale",     name: "Ale",     category: Food, era: 1,     base_price: 3.0, food: 0.7),
        (id: "weaving_shed", name: "Weaving shed", category: Building, era: 1, base_price: 200.0, slots: 12),
        (id: "brewery",      name: "Brewery",      category: Building, era: 1, base_price: 260.0, slots: 10),
        (id: "shears", name: "Shears", category: Tool, era: 2, base_price: 20.0,
            equip: Some((domain: "textiles", bonus: 0.25))),
    ],
    recipes: [
        (id: "shear_sheep", name: "Shear sheep", skill: "shepherding", difficulty: 0.15,
            outputs: [("wool", 3)], nature: Some("pasture"), duration: 1.0, max_team: 3,
            physique: [("endurance", 0.2), ("dexterity", 0.1)]),
        (id: "harvest_flax", name: "Harvest flax", skill: "farming", difficulty: 0.15,
            outputs: [("flax", 4)], nature: Some("flax_field"), duration: 1.0, max_team: 4,
            physique: [("endurance", 0.3)]),
        (id: "spin_wool", name: "Spin wool", skill: "spinning", difficulty: 0.30,
            inputs: [("wool", 2)], outputs: [("yarn", 2)], building: Some("weaving_shed"),
            duration: 1.0, physique: [("dexterity", 0.3)]),
        (id: "spin_flax", name: "Spin flax", skill: "spinning", difficulty: 0.35,
            inputs: [("flax", 3)], outputs: [("yarn", 2)], building: Some("weaving_shed"),
            duration: 1.0, physique: [("dexterity", 0.3)]),
        (id: "weave_cloth", name: "Weave cloth", skill: "weaving", difficulty: 0.45,
            inputs: [("yarn", 3)], outputs: [("cloth", 1)], building: Some("weaving_shed"),
            duration: 1.0, physique: [("dexterity", 0.3), ("perception", 0.1)]),
        (id: "sew_clothes", name: "Sew clothes", skill: "tailoring", difficulty: 0.55,
            inputs: [("cloth", 2)], outputs: [("clothes", 1)], building: Some("workshop"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.4)]),
        (id: "brew_ale", name: "Brew ale", skill: "brewing", difficulty: 0.40,
            inputs: [("grain", 3), ("pot", 1), ("wood", 1)], outputs: [("ale", 5)],
            building: Some("brewery"), duration: 1.0, physique: [("strength", 0.1)]),
        (id: "forge_shears", name: "Forge shears", skill: "toolmaking", difficulty: 0.40,
            inputs: [("bronze", 1)], outputs: [("shears", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("dexterity", 0.2)]),
        (id: "build_weaving_shed", name: "Build weaving shed", skill: "construction", difficulty: 0.30,
            inputs: [("plank", 12), ("wood", 6)], outputs: [("weaving_shed", 1)],
