// Military: soldiers learn Fighting by drilling and in battle. There is no recipe for
// it; squads are mustered and paid by their town (see `military` in models.ron).
//
// Kit is items: each soldier carries a weapon, armour, a shield and a mount if the
// armory has them (goods::Slot). `fight` says what an item does in a squad battle
// (sim_core::battle): reach and range in metres, damage in health per hit (a person
// has 1), strikes and shots per second, `armour` the share of a hit's damage it
// stops, `shield` the share of arrows it stops, `mounted` for a horse. Swords and
// the bronze spear are in 30_metalworking.ron and 35_bronze.ron.
// Durability is in uses of 8 hours; battles wear kit (goods::wear).
(
    skills: [
        (id: "fighting",       name: "Fighting",       domain: "military"),
        (id: "bowyery",        name: "Bowyery",        domain: "woodworking", prereqs: ["carpentry"]),
        (id: "armouring",      name: "Armouring",      domain: "smithing",    prereqs: ["smithing"]),
        (id: "horse_breeding", name: "Horse breeding", domain: "agriculture", prereqs: ["shepherding"]),
    ],
    products: [
        (id: "iron_spear", name: "Iron spear (lvl 2)", category: Weapon, era: 3, tier: 2, base_price: 40.0, kg: 2.5,
            fight: Some((reach: 3.0, damage: 0.45, strike_rate: 0.30, close_penalty: 0.4))),
        (id: "lance", name: "Lance", category: Weapon, era: 3, tier: 2, base_price: 45.0, kg: 4.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 40)),
            fight: Some((reach: 3.0, damage: 0.50, strike_rate: 0.30, close_penalty: 0.3))),
        (id: "bow", name: "Bow", category: Weapon, era: 1, tier: 1, base_price: 20.0, kg: 1.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 80)),
            // A quiver of arrows until arrows are stacks of their own.
            fight: Some((reach: 0.5, damage: 0.25, strike_rate: 0.30, range: 150.0,
                shot_rate: 0.1, shot_damage: 0.40, arrows: 24))),
        (id: "shield", name: "Shield", category: Weapon, era: 1, base_price: 12.0, kg: 5.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 40, slot: Some("shield"))),
            fight: Some((shield: 0.4))),
        (id: "padded_coat", name: "Padded coat", category: Weapon, era: 1, base_price: 30.0, kg: 4.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 60, slot: Some("armour"))),
            fight: Some((armour: 0.2))),
        (id: "mail", name: "Mail shirt", category: Weapon, era: 3, tier: 2, base_price: 160.0, kg: 10.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 150, slot: Some("armour"))),
            fight: Some((armour: 0.5))),
        (id: "horse", name: "Horse", category: Weapon, era: 2, base_price: 120.0, kg: 0.0,
            equip: Some((domain: "military", bonus: 0.0, durability: 400, slot: Some("mount"))),
            fight: Some((mounted: true))),
        (id: "stable", name: "Stable", category: Building, era: 2, base_price: 0.0, slots: 4),
    ],
    recipes: [
        (id: "make_iron_spear", name: "Make iron spear", skill: "spear_making", difficulty: 0.35,
            inputs: [("iron", 1), ("plank", 1)], outputs: [("iron_spear", 1)],
            building: Some("smithy"), duration: 1.0, max_team: 2, physique: [("strength", 0.2), ("dexterity", 0.1)]),
        (id: "make_lance", name: "Make lance", skill: "spear_making", difficulty: 0.40,
            inputs: [("iron", 1), ("plank", 2)], outputs: [("lance", 1)],
            building: Some("smithy"), duration: 1.0, max_team: 2, physique: [("strength", 0.2), ("dexterity", 0.1)]),
        (id: "make_bow", name: "Make bow", skill: "bowyery", difficulty: 0.45,
            inputs: [("plank", 2)], outputs: [("bow", 1)],
            building: Some("workshop"), duration: 1.0, max_team: 2, physique: [("dexterity", 0.3)]),
        (id: "make_shield", name: "Make shield", skill: "carpentry", difficulty: 0.30,
            inputs: [("plank", 3)], outputs: [("shield", 1)],
            building: Some("workshop"), duration: 1.0, max_team: 2, physique: [("dexterity", 0.2)]),
        (id: "sew_padded_coat", name: "Sew padded coat", skill: "tailoring", difficulty: 0.40,
            inputs: [("cloth", 3)], outputs: [("padded_coat", 1)],
            building: Some("workshop"), duration: 1.0, max_team: 2, physique: [("dexterity", 0.3)]),
        (id: "make_mail", name: "Make mail shirt", skill: "armouring", difficulty: 0.60,
            inputs: [("iron", 4), ("charcoal", 2)], outputs: [("mail", 1)],
            building: Some("smithy"), duration: 4.0, max_team: 2, physique: [("dexterity", 0.3), ("endurance", 0.2)]),
        // A stable of breeders raises a horse every few weeks, fed on grain and
        // grazed on pasture.
        (id: "breed_horses", name: "Breed horses", skill: "horse_breeding", difficulty: 0.45,
            inputs: [("grain", 20)], outputs: [("horse", 1)], nature: Some("pasture"),
            building: Some("stable"), duration: 20.0, max_team: 3, physique: [("strength", 0.2), ("endurance", 0.2)]),
        (id: "build_stable", name: "Build stable", skill: "construction", difficulty: 0.35,
            inputs: [("plank", 15), ("wood", 10)], outputs: [("stable", 1)],
            duration: 30.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
