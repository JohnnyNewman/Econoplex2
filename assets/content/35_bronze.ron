// Bronze (era 2): copper and tin, smelted with charcoal and cast into bronze, which
// is easier to work than iron. Bronze makes the first spears and shears.
// Copper and tin rarely sit in the same town, so bronze needs trade.
(
    skills: [
        (id: "bronze_casting", name: "Bronze casting", domain: "metallurgy", prereqs: ["smelting"]),
    ],
    products: [
        (id: "copper_ore", name: "Copper ore", category: Raw,      base_price: 1.5),
        (id: "tin_ore",    name: "Tin ore",    category: Raw,      base_price: 2.5),
        (id: "copper",     name: "Copper",     category: Material, era: 2, base_price: 8.0),
        (id: "tin",        name: "Tin",        category: Material, era: 2, base_price: 14.0),
        (id: "bronze",     name: "Bronze",     category: Material, era: 2, base_price: 14.0),
        (id: "bronze_spear", name: "Bronze spear (lvl 1)", category: Weapon, era: 2, tier: 1, base_price: 45.0),
    ],
    recipes: [
        (id: "mine_copper", name: "Mine copper", skill: "mining", difficulty: 0.15,
            outputs: [("copper_ore", 3)], nature: Some("copper_vein"), duration: 1.0, max_team: 4,
            physique: [("strength", 0.4), ("endurance", 0.2)]),
        (id: "mine_tin", name: "Mine tin", skill: "mining", difficulty: 0.20,
            outputs: [("tin_ore", 2)], nature: Some("tin_vein"), duration: 1.0, max_team: 3,
            physique: [("strength", 0.4), ("endurance", 0.2)]),
        (id: "smelt_copper", name: "Smelt copper", skill: "smelting", difficulty: 0.30,
            inputs: [("copper_ore", 3), ("charcoal", 1)], outputs: [("copper", 2)],
            building: Some("furnace"), duration: 1.0, physique: [("endurance", 0.2)]),
        (id: "smelt_tin", name: "Smelt tin", skill: "smelting", difficulty: 0.35,
            inputs: [("tin_ore", 3), ("charcoal", 1)], outputs: [("tin", 1)],
            building: Some("furnace"), duration: 1.0, physique: [("endurance", 0.2)]),
        (id: "cast_bronze", name: "Cast bronze", skill: "bronze_casting", difficulty: 0.40,
            inputs: [("copper", 3), ("tin", 1), ("charcoal", 1)], outputs: [("bronze", 3)],
            building: Some("furnace"), duration: 1.0, physique: [("endurance", 0.1), ("perception", 0.2)]),
        (id: "make_bronze_spear", name: "Make bronze spear", skill: "bladesmithing", difficulty: 0.40,
            inputs: [("bronze", 2), ("plank", 1)], outputs: [("bronze_spear", 1)],
            building: Some("smithy"), duration: 1.0, max_team: 2, physique: [("strength", 0.2), ("dexterity", 0.1)]),
    ],
)
