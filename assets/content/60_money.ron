// Money: a mint strikes coin. Coin is not stocked: each coin struck is `coin` units
// of new money in the town treasury. A town builds a mint and keeps it working
// while its treasury runs low (see `mint_below_per_capita` in models.ron), or as its
// government orders (`mint TOWN auto|on|off`).
//
// Silver is the best coin metal: a little silver makes a lot of coin. Copper does
// too, at a lower rate. Iron coins are the fallback for towns with neither, and
// they compete with the smiths for iron. Minters take whichever pays best.
(
    skills: [
        (id: "assaying", name: "Assaying", domain: "metallurgy", prereqs: ["smelting"]),
        (id: "coining",  name: "Coining",  domain: "smithing",   prereqs: ["smithing", "assaying"]),
    ],
    products: [
        (id: "silver_ore", name: "Silver ore", category: Raw,      base_price: 4.0),
        // Jewellery and plate: a luxury, wanted far more by the rich.
        (id: "silver",     name: "Silver",     category: Material, era: 2, base_price: 40.0,
            household: Some((want: 0.2, life_days: 3000.0, taste: Some("ambition"), elasticity: Some(1.5)))),
        (id: "mint", name: "Mint", category: Building, era: 2, base_price: 400.0, slots: 4),
        (id: "coin", name: "Coin", category: Material, era: 2, base_price: 1.0, coin: 1.0),
    ],
    recipes: [
        (id: "mine_silver", name: "Mine silver", skill: "mining", difficulty: 0.25,
            outputs: [("silver_ore", 2)], nature: Some("silver_vein"), duration: 1.0, max_team: 3,
            physique: [("strength", 0.4), ("endurance", 0.2)]),
        (id: "refine_silver", name: "Refine silver", skill: "assaying", difficulty: 0.50,
            inputs: [("silver_ore", 4), ("charcoal", 1)], outputs: [("silver", 1)],
            building: Some("furnace"), duration: 1.5, max_team: 2, physique: [("perception", 0.3)]),
        (id: "build_mint", name: "Build mint", skill: "construction", difficulty: 0.45,
            inputs: [("cut_stone", 12), ("plank", 12)], outputs: [("mint", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        // Three person-days of work strike one ingot into coin; four minters strike
        // a little over one ingot a day.
        (id: "strike_silver_coins", name: "Strike silver coins", skill: "coining", difficulty: 0.45,
            inputs: [("silver", 1)], outputs: [("coin", 150)],
            building: Some("mint"), duration: 3.0, max_team: 4,
            physique: [("dexterity", 0.3)]),
        (id: "strike_copper_coins", name: "Strike copper coins", skill: "coining", difficulty: 0.35,
            inputs: [("copper", 2), ("charcoal", 1)], outputs: [("coin", 50)],
            building: Some("mint"), duration: 3.0, max_team: 4,
            physique: [("strength", 0.2), ("dexterity", 0.2)]),
        (id: "strike_coins", name: "Strike iron coins", skill: "coining", difficulty: 0.40,
            inputs: [("iron", 1), ("charcoal", 1)], outputs: [("coin", 60)],
            building: Some("mint"), duration: 3.0, max_team: 4,
            physique: [("strength", 0.2), ("dexterity", 0.2)]),
    ],
)
