// Money: a mint strikes coin from iron and charcoal. Coin is not stocked: each coin
// struck is `coin` units of new money in the town treasury. A town builds a mint and
// keeps it working while its treasury runs low (see `mint_below_per_capita` in
// models.ron), or as its government orders (`mint TOWN auto|on|off`).
(
    products: [
        (id: "mint", name: "Mint", category: Building, base_price: 400.0, slots: 4),
        (id: "coin", name: "Coin", category: Material, base_price: 1.0, coin: 1.0),
    ],
    recipes: [
        (id: "build_mint", name: "Build mint", skill: "construction", difficulty: 0.45,
            inputs: [("plank", 16), ("wood", 10), ("iron", 4)], outputs: [("mint", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        // Three person-days of work turn one iron and one charcoal into 60 coins, so
        // four minters strike about 80 coins a day.
        (id: "strike_coins", name: "Strike coins", skill: "smithing", difficulty: 0.40,
            inputs: [("iron", 1), ("charcoal", 1)], outputs: [("coin", 60)],
            building: Some("mint"), duration: 3.0, max_team: 4,
            physique: [("strength", 0.2), ("dexterity", 0.2)]),
    ],
)
