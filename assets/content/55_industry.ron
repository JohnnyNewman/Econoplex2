// Early industry (era 4): coal and coke, the blast furnace, engineering and machine
// parts, and the mills they drive. Each step needs the eras before it: bricks and
// cut stone for the buildings, iron and steel for the machines.
(
    skills: [
        (id: "coking",       name: "Coking",       domain: "metallurgy",  prereqs: ["charcoal_burning", "mining"]),
        (id: "ironfounding", name: "Ironfounding", domain: "metallurgy",  prereqs: ["smelting", "coking"]),
        (id: "engineering",  name: "Engineering",  domain: "engineering", prereqs: ["toolmaking", "carpentry", "ironfounding"]),
    ],
    products: [
        (id: "coal", name: "Coal", category: Raw,      base_price: 2.0),
        (id: "coke", name: "Coke", category: Material, era: 4, base_price: 5.0),
        (id: "machine_parts", name: "Machine parts", category: Material, era: 4, base_price: 70.0),
        (id: "blast_furnace", name: "Blast furnace", category: Building, era: 4, base_price: 600.0, slots: 10),
        (id: "machine_shop",  name: "Machine shop",  category: Building, era: 4, base_price: 500.0, slots: 8),
        (id: "roller_mill",   name: "Roller mill",   category: Building, era: 4, base_price: 650.0, slots: 12),
        (id: "textile_mill",  name: "Textile mill",  category: Building, era: 4, base_price: 700.0, slots: 16),
        (id: "plough", name: "Iron plough", category: Tool, era: 3, base_price: 45.0,
            equip: Some((domain: "agriculture", bonus: 0.4))),
    ],
    recipes: [
        (id: "mine_coal", name: "Mine coal", skill: "mining", difficulty: 0.20,
            outputs: [("coal", 3)], nature: Some("coal_seam"), duration: 1.0, max_team: 4,
            physique: [("strength", 0.4), ("endurance", 0.3)]),
        (id: "bake_coke", name: "Bake coke", skill: "coking", difficulty: 0.40,
            inputs: [("coal", 3)], outputs: [("coke", 2)], building: Some("kiln"),
            duration: 1.0, physique: [("endurance", 0.3)]),
        // Twice the iron per ore of the charcoal furnace.
        (id: "blast_iron", name: "Blast iron", skill: "ironfounding", difficulty: 0.55,
            inputs: [("ore", 4), ("coke", 1)], outputs: [("iron", 3)], building: Some("blast_furnace"),
            duration: 1.5, max_team: 4, physique: [("endurance", 0.3), ("strength", 0.1)]),
        (id: "blast_steel", name: "Blast steel", skill: "steelmaking", difficulty: 0.70,
            inputs: [("iron", 2), ("coke", 1)], outputs: [("steel", 1)], building: Some("blast_furnace"),
            duration: 1.5, physique: [("endurance", 0.2), ("perception", 0.1)]),
        (id: "make_machine_parts", name: "Make machine parts", skill: "engineering", difficulty: 0.65,
            inputs: [("iron", 2), ("steel", 1), ("plank", 1)], outputs: [("machine_parts", 1)],
            building: Some("machine_shop"), duration: 2.0, max_team: 3,
            physique: [("dexterity", 0.3), ("perception", 0.2)]),
        (id: "forge_plough", name: "Forge plough", skill: "toolmaking", difficulty: 0.50,
            inputs: [("iron", 2), ("plank", 2)], outputs: [("plough", 1)], building: Some("smithy"),
            duration: 1.0, max_team: 2, physique: [("strength", 0.3)]),
        // Mills driven by machinery: more output per worker and per input.
        (id: "roll_flour", name: "Roll flour", skill: "milling", difficulty: 0.50,
            inputs: [("grain", 6)], outputs: [("flour", 8)], building: Some("roller_mill"),
            duration: 1.0, max_team: 4, physique: [("strength", 0.1)]),
        (id: "mill_spin", name: "Spin yarn by machine", skill: "spinning", difficulty: 0.45,
            inputs: [("wool", 4)], outputs: [("yarn", 6)], building: Some("textile_mill"),
            duration: 1.0, max_team: 4, physique: [("dexterity", 0.2)]),
        (id: "mill_weave", name: "Weave cloth by machine", skill: "weaving", difficulty: 0.55,
            inputs: [("yarn", 6)], outputs: [("cloth", 3)], building: Some("textile_mill"),
            duration: 1.0, max_team: 4, physique: [("dexterity", 0.2), ("perception", 0.1)]),
        (id: "build_blast_furnace", name: "Build blast furnace", skill: "construction", difficulty: 0.55,
            inputs: [("brick", 24), ("cut_stone", 12), ("iron", 6)], outputs: [("blast_furnace", 1)],
            duration: 60.0, max_team: 8, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_machine_shop", name: "Build machine shop", skill: "construction", difficulty: 0.50,
            inputs: [("brick", 16), ("iron", 8), ("plank", 10)], outputs: [("machine_shop", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_roller_mill", name: "Build roller mill", skill: "construction", difficulty: 0.55,
            inputs: [("brick", 16), ("cut_stone", 8), ("machine_parts", 3)], outputs: [("roller_mill", 1)],
            duration: 50.0, max_team: 6, physique: [("strength", 0.3), ("endurance", 0.2)]),
        (id: "build_textile_mill", name: "Build textile mill", skill: "construction", difficulty: 0.55,
            inputs: [("brick", 20), ("cut_stone", 10), ("machine_parts", 4)], outputs: [("textile_mill", 1)],
            duration: 60.0, max_team: 8, physique: [("strength", 0.3), ("endurance", 0.2)]),
    ],
)
