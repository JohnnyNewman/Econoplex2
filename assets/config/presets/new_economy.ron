// The redesigned economy, all switched on (see docs/design/needs-ladder.md and
// time-and-weather.md). Each entry overrides one field of models.ron, like
// `--set path=value`. Use with `--preset assets/config/presets/new_economy.ron`
// (sim_cli and the 3D view).
[
    // Households buy what serves their needs; warmth, fuel and clothes; a
    // shared hearth; two weeks of food kept at home.
    ("market.consumption", "Needs((interval: 7, gate_at: 0.7, gate_width: 0.15, comfort_c: 16.0, house_c: 6.0, max_clothes: 2.0, fire_per_c: 0.5, fire_per_extra_person: 0.25, savings_days: 60.0, larder_days: 14.0, cold_damage: 0.02, plan_days: 30.0, fixed_needs: [(Belonging, 0.5), (Esteem, 0.5)]))"),
    // Crops follow the temperature, stand in the field until reaped, rot if late.
    ("farming", "Seasonal(crops: [\"field\", \"flax_field\", \"pasture\"], crop_capacity: 15.0, frost_loss: 0.05, rot_wet: 0.02, rot_cold: 0.01)"),
    // Feeding the town is the ruler's job: granary, seed reserve, food planner.
    ("market.food_rules", "Ruler"),
    // Outdoor work follows the daylight.
    ("time.work_hours", "Daylight"),
    // The market counts tools and weapons by what its armory holds.
    ("market.item_stock", "Held"),
]
