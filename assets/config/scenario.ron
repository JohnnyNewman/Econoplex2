// Starting world: four towns with different natural endowments. Ironhold has iron,
// coal and stone; Greenvale fields, sheep, flax and clay; Timberwick forests, tin
// and clay; Brassmoor copper, silver and stone. Bronze needs Brassmoor's copper and
// Timberwick's tin, bricks need clay, the blast furnace needs Ironhold's coal.
(
    seed: 42,
    // The town the player governs in the game; the headless runner ignores it.
    player: Some("Greenvale"),
    // How the match is won: the first free town (paying no tribute) that has made
    // `amount` of `product` in total, in a year it did not go hungry (at most
    // `max_starving` of its person-days starving). After `years`, the free town
    // closest to the goal wins. Off for now (endless play); for example:
    // goal: Some((product: "longsword_3", amount: 5.0, max_starving: 0.02, years: 40)),
    goal: None,
    // Generate the towns, their land and the rivers from the seed instead of the
    // fixed towns below (or run the CLI with --generate N). For example:
    // generate: Some((towns: 5, population: (240, 340), half_size: (1000.0, 750.0),
    //     min_distance: 450.0, rivers: 1, sites: 3.0)),
    generate: None,
    towns: [
        (
            name: "Ironhold", position: (-450.0, 250.0), population: 300,
            nature: [("ore_vein", 4), ("forest", 3), ("field", 3), ("coal_seam", 2), ("quarry", 2)],
            buildings: ["furnace", "smithy", "workshop", "mill", "bakery"],
            stock: [("bread", 900.0), ("wood", 30.0)],
        ),
        (
            name: "Greenvale", position: (450.0, 250.0), population: 300,
            nature: [("field", 6), ("forest", 4), ("pasture", 3), ("flax_field", 2), ("clay_pit", 2)],
            buildings: ["mill", "bakery", "workshop"],
            stock: [("bread", 900.0), ("wood", 30.0)],
        ),
        (
            name: "Timberwick", position: (-450.0, -250.0), population: 300,
            nature: [("forest", 6), ("field", 3), ("ore_vein", 1), ("tin_vein", 2), ("clay_pit", 2), ("pasture", 1)],
            buildings: ["workshop", "furnace", "mill", "bakery"],
            stock: [("bread", 900.0), ("wood", 30.0)],
        ),
        (
            name: "Brassmoor", position: (450.0, -250.0), population: 300,
            nature: [("ore_vein", 2), ("field", 4), ("forest", 2), ("copper_vein", 3), ("silver_vein", 1), ("quarry", 1)],
            buildings: ["furnace", "smithy", "mill", "bakery", "workshop"],
            stock: [("bread", 900.0), ("wood", 30.0)],
        ),
    ],
    // A river runs north to south between the western and the eastern towns. It
    // can be crossed at two fords: one in the north and one far to the south, so
    // the northern neighbors trade easily and the southern ones go the long way.
    terrain: Some((
        cell: 20.0,
        half_size: (900.0, 700.0),
        hill_cost: 1.5,
        hill_scale: 260.0,
        rivers: [
            (
                points: [(-40.0, -800.0), (30.0, -380.0), (-30.0, 0.0), (40.0, 380.0), (-20.0, 800.0)],
                width: 50.0,
                fords: [(30.0, 330.0), (10.0, -600.0)],
                ford_width: 70.0,
                ford_cost: 2.5,
            ),
        ],
    )),
)
